BasedOnStyle: LLVM
Language: Cpp
Standard: c++20

ColumnLimit: 100
IndentWidth: 4
TabWidth: 4
UseTab: Never

PointerAlignment: Left
BreakBeforeBraces: Allman
NamespaceIndentation: None

SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: ControlStatements

IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^[<][a-z0-9_./]+[>]'
    Priority: 1
  - Regex: '^[<](SFML|glm|entt)[/]'
    Priority: 2
  - Regex: '^["]'
    Priority: 3
  - Regex: '.*'
    Priority: 4